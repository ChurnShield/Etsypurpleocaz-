{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/scripts/session-start.sh",
            "timeout": 15
          }
        ],
        "description": "Load SOUL.md, STANDUP.md, LESSONS.md, and prior session state"
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/scripts/pre-compact.sh",
            "timeout": 10
          }
        ],
        "description": "Save context state before compression"
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop.sh",
            "timeout": 10
          }
        ],
        "description": "Session end checklist reminder (existing)"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/scripts/session-stop.sh",
            "timeout": 10
          }
        ],
        "description": "Persist session state after each response"
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(pytest tests/ -v)",
      "Bash(python scripts/init_db.py)",
      "Bash(python main.py *)",
      "Bash(pip install -r requirements.txt)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(* --force *)",
      "Bash(DROP TABLE *)",
      "Bash(* data/system.db *)"
    ]
  },
  "env": {
    "PYTHONPATH": "."
  }
}
