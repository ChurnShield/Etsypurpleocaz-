ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
DATABASE_PATH=data/system.db

# -- Gemini API (Nano Banana -- AI image generation for premium products)
GEMINI_API_KEY=your-gemini-api-key-here

# -- xAI Grok image generation (grok-2-image-1212)
# Get a key at: https://console.x.ai
XAI_API_KEY=your-xai-api-key-here

# -- Image provider routing
# Options: ideogram, grok, both
# "both" generates one image per provider for side-by-side comparison
IMAGE_PROVIDER=both

# ── AI News RSS Workflow ──────────────────────────────────────────────────────
# RSS feed URL (already pre-filled with your Skool feed)
RSS_FEED_URL=https://rssgenerator.mooo.com/feeds/?p=aaHR0cHM6Ly93d3cuc2tvb2wuY29tL2FpLWJ1c2luZXNzLWJ1aWxkZXJzL2NsYXNzcm9vbS9lNzA1Y2NkND9tZD00MjM3ZmJlZjFhNzA0ZDg5ODNlZjk5OGZlYjE1ZWRkMw==

# How many hours back to look for recent articles (default: 24)
LOOKBACK_HOURS=24

# Google Sheets credentials
# Full setup guide: see the top of workflows/ai_news_rss/tools/save_to_google_sheets_tool.py
#
# GOOGLE_CREDENTIALS_FILE  Path to the service account JSON key you downloaded
#                          from Google Cloud Console → IAM & Admin → Service Accounts
# GOOGLE_SPREADSHEET_ID    The long ID in your Sheet URL:
#                          docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
# GOOGLE_SHEET_NAME        Name of the worksheet tab (default: AI News)
GOOGLE_CREDENTIALS_FILE=google-credentials.json
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id-here
GOOGLE_SHEET_NAME=AI News

# ── Etsy API Credentials ─────────────────────────────────────────────────────
# Get these from https://developers.etsy.com → Your Apps
# ETSY_API_KEYSTRING   Your app's keystring (client ID)
# ETSY_SHARED_SECRET   Your app's shared secret
# ETSY_SHOP_ID         Numeric shop ID (find in page source: search for "shop_id")
#
# After setting these, run:  python workflows/etsy_analytics/etsy_oauth.py
# to complete OAuth and generate etsy_tokens.json
ETSY_API_KEYSTRING=your-etsy-keystring-here
ETSY_SHARED_SECRET=your-etsy-secret-here
ETSY_SHOP_ID=your-shop-id-here

# ── YouTube Intelligence Feed ──────────────────────────────────────────────
# YouTube Data API v3 key (required for server-side transcript pipeline)
# Get one free at: https://console.cloud.google.com → APIs & Services → Credentials
# Enable "YouTube Data API v3" in the API Library
# Free quota: 10,000 units/day (enough for ~100 channel scans + video lookups per week)
YOUTUBE_API_KEY=your-youtube-api-key-here
