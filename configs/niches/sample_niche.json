  "_template_types_reference": {
    "business_card":        "1050×600px landscape. variant: dark or light.",
    "appointment_card":     "1050×600px landscape. Fields: date, time, service, pet_name, notes.",
    "loyalty_card":         "1050×600px landscape. stamp_count: number of stamps before reward.",
    "referral_card":        "1050×600px landscape. offer + body + fields.",
    "thank_you_card":       "1050×600px landscape. headline + body + cta.",
    "gift_certificate":     "2550×1800px landscape. headline + body + fields list.",
    "welcome_sign":         "2480×3508px A4 portrait. headline + body + optional contact.",
    "opening_hours_sign":   "2480×3508px A4 portrait. hours: [[day, time], ...] array.",
    "flyer_a4":             "2480×3508px A4 portrait. headline + offer + body + footer.",
    "price_list":           "2480×3508px A4 portrait. sections: [{heading, items:[name,price]}].",
    "form_a4":              "2480×3508px A4 portrait. rows: row-spec objects (see below).",
    "invoice":              "2480×3508px A4 portrait. line_items: list of service name strings.",
    "booking_confirmation": "2480×3508px A4 portrait. fields: list of field label strings.",
    "social_1080":          "1080×1080px square. variant: offer|tip|review|announce.",
    "certificate":          "2550×1800px landscape. headline + body + fields.",
    "income_tracker":       "2480×3508px A4 portrait. extra_cols: column header strings.",
    "expenses_tracker":     "2480×3508px A4 portrait. extra_cols: column header strings."
  },

  "_row_spec_reference": {
    "section_header":  "{ type, label }  — Bold heading bar across full width",
    "field_single":    "{ type, label, height? }  — One labelled field spanning full width",
    "field_pair":      "{ type, labels: [left, right] }  — Two equal-width fields side by side",
    "field_triple":    "{ type, labels: [a, b, c] }  — Three equal-width fields",
    "checkbox_group":  "{ type, label, items: [...] }  — Label above a row of checkboxes",
    "table":           "{ type, headers: [...], col_widths: [0.x, ...], rows: N }  — Lined table (widths must sum to 1.0)",
    "text_block":      "{ type, text, height? }  — Free text / instructions paragraph",
    "spacer":          "{ type, height }  — Blank vertical gap"
  }
