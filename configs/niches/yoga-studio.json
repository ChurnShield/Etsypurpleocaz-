    "expenses_tracker": "2480×3508px A4 portrait. extra_cols: column header strings.",
    "flyer_a4": "2480×3508px A4 portrait. headline + offer + body + footer.",
    "form_a4": "2480×3508px A4 portrait. rows: row-spec objects (see below).",
    "gift_certificate": "2550×1800px landscape. headline + body + fields list.",
    "income_tracker": "2480×3508px A4 portrait. extra_cols: column header strings.",
