#!/bin/bash
# Pre-commit secrets scanner
# Blocks commits containing hardcoded secrets or credentials

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

FOUND=0

# Get list of staged files (added or modified, not deleted)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# Files to skip (scanner definitions, not real secrets)
SKIP_FILES="hooks/pre-commit"

check_pattern() {
  local label="$1"
  local pattern="$2"
  local file="$3"

  matches=$(git show ":$file" 2>/dev/null | grep -En "$pattern")
  if [ -n "$matches" ]; then
    echo -e "${RED}[SECRETS SCANNER] Potential secret found in: $file${NC}"
    echo -e "${YELLOW}  Pattern: $label${NC}"
    echo "$matches" | head -5 | sed 's/^/  Line /'
    echo ""
    FOUND=1
  fi
}

for FILE in $STAGED_FILES; do
  # Skip allowlisted files (e.g. this script itself)
  if echo "$SKIP_FILES" | grep -qF "$FILE"; then
    continue
  fi

  # Skip binary files
  if git show ":$FILE" 2>/dev/null | grep -qP '\x00'; then
    continue
  fi

  # Build patterns at runtime to avoid self-match
  PAT_ANTHROPIC="sk-ant-""api"
  PAT_GEMINI="gsk_[A-Za-z0-9]{20,}"
  PAT_GOOGLE="AIzaSy""[A-Za-z0-9_\-]{30,}"
  PAT_GITHUB="ghp_""[A-Za-z0-9]{30,}"
  PAT_PINTEREST="PINTEREST_""PASSWORD="
  PAT_PASSWORD="PASSWORD=""[^'\"]?[^YR][^O][^U][^R_]"

  check_pattern "Anthropic API key"  "$PAT_ANTHROPIC"  "$FILE"
  check_pattern "Google Gemini key"  "$PAT_GEMINI"     "$FILE"
  check_pattern "Google API key"     "$PAT_GOOGLE"     "$FILE"
  check_pattern "GitHub PAT"         "$PAT_GITHUB"     "$FILE"
  check_pattern "Pinterest password" "$PAT_PINTEREST"  "$FILE"
  check_pattern "PASSWORD= with real value" "$PAT_PASSWORD" "$FILE"
done

if [ "$FOUND" -eq 1 ]; then
  echo -e "${RED}╔══════════════════════════════════════════════════════╗${NC}"
  echo -e "${RED}║  COMMIT BLOCKED — possible secrets in staged files  ║${NC}"
  echo -e "${RED}╚══════════════════════════════════════════════════════╝${NC}"
  echo ""
  echo "  Fix: remove the secret, use environment variables instead."
  echo "  Override (DANGEROUS): git commit --no-verify"
  echo ""
  exit 1
fi

exit 0
